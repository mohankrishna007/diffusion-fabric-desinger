# Environment Configuration
# Copy this file to .env and update with your settings

# Application
APP_NAME=Diffusion Fabric Designer
DEBUG=False
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Pipeline
PIPELINE_CONFIG_PATH=config/pipeline.yaml
MAX_CONCURRENT_PIPELINES=5

# Storage (for future use)
# DATA_DIR=data/
# OUTPUT_DIR=output/
# CACHE_DIR=cache/

# AI Models (for Stage 3 - when implemented)
# DIFFUSION_MODEL=stabilityai/stable-diffusion-2-1
# CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_canny
# DEVICE=cuda  # or cpu
# TORCH_HOME=models/

# Database (for future use)
# DATABASE_URL=sqlite:///./weaver.db

# Authentication (for future use)
# API_KEY_ENABLED=False
# API_KEY=your-secret-api-key

# Monitoring (for future use)
# SENTRY_DSN=
# PROMETHEUS_ENABLED=False
